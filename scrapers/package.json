{
  "name": "catch-scrapers",
  "version": "1.0.0",
  "description": "CATCH Scrapers: Puppeteer + BS4 (via Python subprocess) scheduled jobs",
  "scripts": {
    "seed": "node src/jobs/seedLoader.js",
    "dev": "ts-node-dev --respawn --transpile-only src/scheduler.ts",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "mongoose": "^8.4.0",
    "node-cron": "^3.0.3",
    "puppeteer": "^22.11.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
