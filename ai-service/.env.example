# CATCH AI Service Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Service
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ML Models
CONFIDENCE_THRESHOLD=0.70
YOLO_WEIGHTS=ml/weights/yolov8_catch.pt
YOLO_FALLBACK_WEIGHTS=yolov8n.pt
MOBILENET_WEIGHTS=ml/weights/mobilenet_catch.pt
FABRIC_MODEL_WEIGHTS=ml/weights/fabric_classifier.pkl
DEVICE=cpu

# Downstream
LOGIC_SERVICE_URL=http://logic-service:3001
LOGIC_SERVICE_TIMEOUT=10

# Security
AI_SERVICE_API_KEY=dev-insecure-key

# Logging
LATENCY_LOG_FILE=logs/latency.jsonl